                            style="font-size: 55px;"
                        ></i>

                    </div>


                    <div class="card-body p-4">

                        <div
                            class="d-flex justify-content-between
                            align-items-center mb-3"
                        >

                            <h4 class="fw-bold mb-0">
                                Farmer Marketplace
                            </h4>

                            <span
                                class="badge text-bg-dark"
                            >
                                03
                            </span>

                        </div>


                        <p class="text-secondary">

                            Secure farmer-to-buyer marketplace
                            concept with AI-powered fraud
                            detection.

                        </p>


                        <div
                            class="d-flex flex-wrap gap-2 mb-4"
                        >

                            <span class="badge text-bg-secondary">
                                Web Development
                            </span>

                            <span class="badge text-bg-secondary">
                                AI
                            </span>

                            <span class="badge text-bg-secondary">
                                Database
                            </span>

                        </div>


                        <a
                            href="#"
                            class="btn btn-outline-dark"
                        >

                            View Project

                            <i
                                class="fa-solid fa-arrow-up-right-from-square ms-2"
                            ></i>

                        </a>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>



<!-- ===================================================== -->
<!-- CONTACT SECTION -->
<!-- ===================================================== -->

<section
    id="contact"
    class="py-5 bg-light"
>

    <div class="container py-5">


        <div
            class="text-center mb-5"
        >

            <p class="text-info fw-bold mb-2">
                GET IN TOUCH
            </p>


            <h2 class="display-6 fw-bold">
                Let's Work Together
            </h2>


            <p class="text-secondary">

                Have a project, opportunity or idea?
                Feel free to contact me.

            </p>

        </div>



        <!-- ================================================= -->
        <!-- SUCCESS MESSAGE -->
        <!-- ================================================= -->

        <% if (typeof success !== "undefined" && success) { %>

            <div
                class="alert alert-success
                alert-dismissible fade show
                text-center shadow-sm"
                role="alert"
            >

                <i
                    class="fa-solid fa-circle-check me-2"
                ></i>

                Your message has been sent successfully!

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>



        <!-- ================================================= -->
        <!-- ERROR MESSAGE -->
        <!-- ================================================= -->

        <% if (typeof error !== "undefined" && error) { %>

            <div
                class="alert alert-danger
                alert-dismissible fade show
                text-center shadow-sm"
                role="alert"
            >

                <i
                    class="fa-solid fa-circle-exclamation me-2"
                ></i>

                Something went wrong. Please try again.

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>



        <!-- ================================================= -->
        <!-- CONTACT FORM -->
        <!-- ================================================= -->

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div
                    class="card border-0 shadow-lg rounded-4"
                >

                    <div class="card-body p-4 p-md-5">


                        <form
                            action="/contact"
                            method="POST"
                        >

                            <div class="row g-4">


                                <!-- NAME -->

                                <div class="col-md-6">

                                    <label
                                        for="name"
                                        class="form-label fw-semibold"
                                    >
                                        Name
                                    </label>


                                    <input
                                        type="text"
                                        id="name"
                                        name="name"
                                        class="form-control form-control-lg"
                                        placeholder="Enter your name"
                                        autocomplete="name"
                                        required
                                    >

                                </div>



                                <!-- EMAIL -->

                                <div class="col-md-6">

                                    <label
                                        for="email"
                                        class="form-label fw-semibold"
                                    >
                                        Email
                                    </label>


                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        class="form-control form-control-lg"
                                        placeholder="Enter your email"
                                        autocomplete="email"
                                        required
                                    >

                                </div>



                                <!-- SUBJECT -->

                                <div class="col-12">

                                    <label
                                        for="subject"
                                        class="form-label fw-semibold"
                                    >
                                        Subject
                                    </label>


                                    <input
                                        type="text"
                                        id="subject"
                                        name="subject"
                                        class="form-control form-control-lg"
                                        placeholder="Enter subject"
                                    >

                                </div>



                                <!-- MESSAGE -->

                                <div class="col-12">

                                    <label
                                        for="message"
                                        class="form-label fw-semibold"
                                    >
                                        Message
                                    </label>


                                    <textarea
                                        id="message"
                                        name="message"
                                        class="form-control"
                                        rows="6"
                                        placeholder="Write your message..."
                                        required
                                    ></textarea>

                                </div>



                                <!-- SUBMIT -->

                                <div
                                    class="col-12 text-center pt-2"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-dark btn-lg px-5"
                                    >

                                        <i
                                            class="fa-solid fa-paper-plane me-2"
                                        ></i>

                                        Send Message

                                    </button>

                                </div>


                            </div>

                        </form>


                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



